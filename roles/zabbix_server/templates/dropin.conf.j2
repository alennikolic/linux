{{ '#' }} ===========================================================================
{{ '#' }} UPRAVLJA ANSIBLE ROLA: zabbix_server
{{ '#' }}
{{ '#' }} Rucne izmene bice prebrisane pri sledecem prolazu role.
{{ '#' }}
{{ '#' }} Fajl se ucitava kroz Include direktivu na kraju
{{ '#' }} {{ _zabbix_server_main_conf }}.
{{ '#' }} Posto Zabbix obradjuje Include tamo gde ga procita, vrednosti odavde
{{ '#' }} nadjacavaju iste parametre iz podrazumevane konfiguracije.
{{ '#' }}
{{ '#' }} Fajl sadrzi lozinku baze - dozvole su 0640, vlasnik root:zabbix.
{{ '#' }} ===========================================================================

{{ '#' }} --- Baza -------------------------------------------------------------
DBHost={{ role_zabbix_server_db_host }}
DBName={{ role_zabbix_server_db_name }}
DBUser={{ role_zabbix_server_db_user }}
DBPassword={{ role_zabbix_server_db_password }}
{% if role_zabbix_server_db_socket | length > 0 %}
DBSocket={{ role_zabbix_server_db_socket }}
{% endif %}
{% if _zabbix_server_write_db_port | bool %}
DBPort={{ role_zabbix_server_db_port }}
{% endif %}
{% if role_zabbix_server_config | length > 0 %}

{{ '#' }} --- Parametri iz role_zabbix_server_config ---------------------------
{% for key, value in role_zabbix_server_config | dictsort %}
{% if value is sequence and value is not string %}
{% for item in value %}
{{ key }}={{ item }}
{% endfor %}
{% else %}
{{ key }}={{ value }}
{% endif %}
{% endfor %}
{% endif %}
{% if role_zabbix_server_extra_config | length > 0 %}

{{ '#' }} --- role_zabbix_server_extra_config ----------------------------------
{{ role_zabbix_server_extra_config }}
{% endif %}
