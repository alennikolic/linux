# .gitignore
#
# Zastita javnog repozitorijuma.
#
# Ovde ide SAMO kod: role, playbook-ovi i bootstrap sablon.
# Inventory, varijable i tajne pripadaju radnom folderu izvan git-a.
#
# NAPOMENA: bootstrap/template/ je namerno IZUZET iz pravila ispod —
# to je prazan sablon bez stvarnih podataka i mora ostati u
# repozitorijumu.

# --- Inventory (osim sablona) ----------------------------------------
inventory/
group_vars/
host_vars/

!bootstrap/template/inventory/
!bootstrap/template/inventory/**

# --- Tajne -----------------------------------------------------------
vault-pass*
.vault-pass*
*vault_pass*
*.key
*.pem
*.p12
*.pfx
*.crt
*.jks
id_rsa*
id_ed25519*
*.kdbx
secrets.yml
secrets.yaml
*secret*
*.env
.env*

# --- Ansible radni fajlovi -------------------------------------------
# Kosa crta na pocetku vezuje pravilo za KOREN repozitorijuma.
# Bez nje bi bilo ignorisano i bootstrap/template/ansible.cfg, koje
# mora ostati u repozitorijumu.
/ansible.cfg
*.retry
.facts/
fact_cache/
*.log
ansible.log

# --- Editor i sistem -------------------------------------------------
*.swp
*.swo
*~
.DS_Store
.idea/
.vscode/

# --- Python ----------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
