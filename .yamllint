---
# .yamllint
#
# Podesavanja za yamllint. Cilj je da alat hvata prave greske, a ne
# da se svadja sa namernim stilom ovog repozitorijuma.
#
# Rucno pokretanje na kontrolnom cvoru, ako ti treba pre commit-a:
#   yamllint --strict .

extends: default

ignore: |
  .git/
  .venv/
  venv/
  # Jinja sabloni nisu YAML — {% if %} blokovi i {{ }} izrazi bi
  # razbili parser. Njih pokriva ansible-lint kroz ucitavanje role.
  *.j2

rules:

  # -------------------------------------------------------------------
  # Ono zbog cega alat i postoji
  # -------------------------------------------------------------------

  # Dupli kljuc u defaults/main.yml je najopasnija tiha greska u ovom
  # repozitorijumu: YAML uzme drugu vrednost, prvu odbaci, i nista ne
  # prijavi. Ovo se NE iskljucuje.
  key-duplicates: enable

  trailing-spaces: enable

  # -------------------------------------------------------------------
  # Prilagodjeno Jinja sintaksi
  # -------------------------------------------------------------------
  # YAML parser {{ var }} vidi kao ugnjezdenu flow mapu sa razmakom
  # unutar zagrada. Sa podrazumevanom vrednoscu 0 svaki Jinja izraz
  # koji nije u navodnicima prijavljuje dve greske — a takvih izraza
  # ima u svakoj roli.
  #
  # Vrednost 1 je ista ona koju ansible-lint koristi u svojoj
  # ugradjenoj yamllint konfiguraciji, i to iz istog razloga.
  #
  # Prava greska — {  var  } sa dva razmaka — i dalje biva uhvacena.
  braces:
    max-spaces-inside: 1
    min-spaces-inside: 0
    max-spaces-inside-empty: 0
    min-spaces-inside-empty: 0

  # Isto obrazlozenje, za liste zapisane u jednoj liniji.
  brackets:
    max-spaces-inside: 1
    min-spaces-inside: 0
    max-spaces-inside-empty: 0
    min-spaces-inside-empty: 0

  # Poravnavanje kolona u listama recnika je stil ovog repozitorijuma:
  #
  #   - { rule: allow, port: 80,   proto: tcp }
  #   - { rule: allow, port: 443,  proto: tcp }
  #
  # Podrazumevano pravilo bi svaki visak razmaka posle zareza
  # prijavilo kao gresku.
  commas:
    max-spaces-after: -1

  # -------------------------------------------------------------------
  # Prilagodjeno stilu repozitorijuma
  # -------------------------------------------------------------------

  # Komentari u ovom projektu su obimni i objasnjavaju "zasto", pa
  # linije ume da budu duze od podrazumevanih 80. 160 je gornja granica
  # iznad koje fajl prestaje da bude citljiv u split ekranu.
  # "warning" znaci da se prijavljuje, ali ne obara CI.
  line-length:
    max: 160
    level: warning
    allow-non-breakable-words: true
    allow-non-breakable-inline-mappings: true

  # playbook.yml koristi "become: yes", sto je legitiman YAML i
  # uobicajen Ansible stil. Ne teramo prepravku 14 linija zbog
  # kozmetike.
  #
  # check-keys: false je neophodan zbog GitHub Actions sintakse —
  # kljuc "on:" YAML parser inace tumaci kao boolean True.
  truthy:
    allowed-values: ["true", "false", "yes", "no"]
    check-keys: false

  # Komentari uvuceni na nivo bloka ispod njih su namerni u ovom
  # projektu (blokovi sa ===== razdvajacima). Podrazumevano pravilo
  # bi ih prijavljivalo kao pogresno uvucene.
  comments-indentation: disable

  # Zaostale zakomentarisane linije koda tipa "#role_x: []" ostaju
  # greska — to je trag privremene izmene koja nije vracena. Ali
  # minimum dva razmaka pre inline komentara je preterivanje.
  comments:
    min-spaces-from-content: 1
    require-starting-space: true

  # Svi YAML fajlovi u repozitorijumu pocinju sa "---". Zadrzavamo to.
  document-start:
    present: true

  # Prazna vrednost je legitimna u aktivacionim fajlovima i
  # placeholder varijablama.
  empty-values: disable

  # Uvlacenje: lista uvucena unutar kljuca je stil ovog projekta.
  indentation:
    spaces: 2
    indent-sequences: consistent
    check-multi-line-strings: false

  # Vise praznih linija razdvaja sekcije u dugackim defaults fajlovima
  # i to je namerno.
  empty-lines:
    max: 3
    max-start: 0
    max-end: 1
