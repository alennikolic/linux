# bootstrap/template/inventory/hosts.ini.example
#
# Preimenuj ovaj fajl u hosts.ini i upisi svoje hostove.
#
# Svaka grupa ispod odgovara jednoj roli. Host koji upises u grupu
# dobija tu rolu; host koji nije naveden ne dobija nista.
#
# Isti host se pojavljuje u onoliko grupa koliko rola treba da primi.
#
# Prefiks grupe:
#   apply_   — menja stanje onoga sto vec postoji (konfiguracija)
#   deploy_  — donosi nesto novo na sistem (instalacija)
#
# Aktivacione prekidace (role_<ime>_enabled) postavljaju fajlovi u
# group_vars/ — njih ne treba dirati.


# =====================================================================
# HOSTOVI
# =====================================================================
# Definisi hostove jednom, sa parametrima konekcije, pa ih dalje samo
# navodi po imenu u grupama ispod.

[all]
# srv-web-01  ansible_host=10.0.0.11
# srv-web-02  ansible_host=10.0.0.12
# srv-db-01   ansible_host=10.0.0.21  ansible_user=admin


# =====================================================================
# SEMANTICKE GRUPE (opciono)
# =====================================================================
# Korisne za kaskadno ukljucivanje preko :children, umesto ponavljanja
# istih hostova u vise aktivacionih grupa.

[webservers]
# srv-web-01
# srv-web-02

[dbservers]
# srv-db-01


# =====================================================================
# BOOTSTRAP
# =====================================================================
# Sveze instalirani serveri koji jos nemaju "ansible" nalog.
#
# Ova grupa se NE pokrece kroz apply.sh, nego jednokratno:
#
#   ansible-playbook ../linux/playbooks/bootstrap.yml \
#     --limit <host> --user root --ask-pass --ask-become-pass
#
# Posle uspesne pripreme host se moze prebaciti u ostale grupe.

[bootstrap]
# srv-web-01


# =====================================================================
# OSNOVNA KONFIGURACIJA SISTEMA
# =====================================================================

[apply_timezone]
# Vremenska zona i sinhronizacija vremena.

[apply_banner]
# Sadrzaj /etc/motd.

[apply_firewall]
# Pravila zastitnog zida.
# PAZNJA: pogresna pravila mogu prekinuti SSH pristup.

[apply_etc_hosts]
# Unosi u /etc/hosts.

[apply_users]
# Nalozi, grupe i SSH kljucevi.


# =====================================================================
# PAKETI I REPOZITORIJUMI
# =====================================================================
# Redosled u playbook-u: repos → packages → updates.

[apply_repos]
# Sistemski i interni repozitorijumi.
# Parametri: role_repos_list, role_repos_gpg_check, role_repos_remove

[deploy_packages]
# Instalacija i uklanjanje paketa.
# Parametri: role_packages_install, role_packages_remove

# Primer kaskadnog ukljucivanja:
# [deploy_packages:children]
# webservers
# dbservers

[apply_updates]
# Azuriranje celog sistema ili pojedinacnih paketa.
# Parametri: role_updates_all, role_updates_packages, role_updates_reboot
# Play koristi serial: 1 — host po host.


# =====================================================================
# SERTIFIKATI
# =====================================================================

[deploy_root_ca]
# Instalacija Root CA sertifikata.


# =====================================================================
# ZABBIX
# =====================================================================

[deploy_zabbix_agent]

[deploy_zabbix_db]

[deploy_zabbix_server]

[deploy_zabbix_web]

[deploy_zabbix_proxy]

[apply_zabbix_provisioning]
# Hostovi, sabloni i akcije kroz Zabbix API.
# Ne instalira softver — otuda apply_ prefiks.
